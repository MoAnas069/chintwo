rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Media, artwork documentation, certificates, and monographs
    match /artworks/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
    }
  }
}
